# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Fine-grained PAT scoped to ONE repository.
# Permissions needed: Issues -> Read and write   (Metadata -> Read is implied)
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_replace_me

# The repository this gateway is bound to.
GITHUB_OWNER=your-github-username
GITHUB_REPO=cmpe272-issues-gw

# Shared secret for webhook HMAC. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must match the secret configured in the repo's webhook settings exactly.
WEBHOOK_SECRET=replace_me_with_32_random_bytes_hex

# Port this service listens on.
PORT=8080

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# EVENTS_DB_PATH=data/events.db
# ENABLE_ETAG_CACHE=true
# REQUEST_TIMEOUT_SECONDS=15
