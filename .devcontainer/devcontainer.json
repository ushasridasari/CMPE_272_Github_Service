{
  "name": "GitHub Issues Gateway",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Issues Gateway",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install --user -r requirements-dev.txt && cp -n .env.example .env || true",
  "postAttachCommand": {
    "hint": "echo 'Fill in .env, then run: make run  (see make help)'"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "42Crunch.vscode-openapi",
        "humao.rest-client"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests/unit"],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "yaml.schemas": {
          "https://raw.githubusercontent.com/OAI/OpenAPI-Specification/main/schemas/v3.1/schema.json": "openapi.yaml"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
